// nett.gotry.io: a Cloudflare Worker that serves static files on its custom domain; Cloudflare
// manages the DNS record and certificate. The release workflow builds site/ at the repository root,
// then deploys it with:
//   npx wrangler deploy --config packaging/site/wrangler.jsonc
{
  "name": "nett",
  "compatibility_date": "2026-10-19",
  "assets": { "directory": "../../site" },
  "routes": [{ "pattern": "nett.gotry.io", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
