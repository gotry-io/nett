# nett on Synology DSM: the mesh, the TLS transport, and, once the machine has joined a Hub, the
# connection to its Hub, which also installs new releases into /usr/local/lib/nett after verifying
# their release signature. Installed by `sudo nett install`, started at boot by the Task Scheduler
# task `nett`, which runs `nett install` again and so also writes this file back when a DSM update
# removed it.
# Everything it keeps is in /etc/nett, root only. After the desired state changes,
# `systemctl reload nett` applies it without a restart.
# DSM's systemd ignores directives it does not know, so this unit uses only ones it has.
[Unit]
Description=nett

[Service]
ExecStart=/usr/local/lib/nett/nett daemon --dir /etc/nett
ExecReload=/bin/kill -HUP $MAINPID
# Local sockets in /run/nett: mesh.sock answers every local user's status queries and takes changes
# only from root. Others can reach a known name in the directory but not list it
RuntimeDirectory=nett
RuntimeDirectoryMode=0711
# Root, kept to the capabilities for the TUN interface and its routes, binding the in-tunnel probe
# socket to the interface, and the DNS responder on the mesh address (UDP 53)
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# A root process can write any file root owns, so the whole file system is read-only for it except
# its own directory, the program it upgrades, nett's units and its sockets
ReadOnlyDirectories=/
ReadWriteDirectories=/etc/nett /usr/local/lib/nett /usr/local/lib/systemd/system /run/nett
PrivateTmp=yes
# Idle use stays under 8 MB; the limit leaves room for a large desired state or a download. The OOM
# killer picks it late
MemoryLimit=64M
OOMScoreAdjust=-500
# It also exits to run a new release once it has installed it
Restart=always
RestartSec=2
