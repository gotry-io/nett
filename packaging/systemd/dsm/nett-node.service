# nett-node on Synology DSM, the agent that connects this machine to its Hub. Installed by
# `sudo nett install <token>`, started at boot by the Task Scheduler task `nett`.
# It writes the desired state from the Hub to /etc/nett/desired.json, asks the mesh service to reload
# it, reports status, and installs new releases into /usr/local/lib/nett after verifying their
# release signature. The mesh keeps running without this service; systemd restarts each one.
# DSM's systemd ignores directives it does not know, so this unit uses only ones it has.
[Unit]
Description=nett node agent
After=nett-mesh.service

[Service]
ExecStart=/usr/local/lib/nett/nett node --dir /etc/nett
# Root, to write the desired state, replace the program and refresh nett's units after an upgrade;
# CAP_DAC_OVERRIDE lets it reach the mesh service's socket. It listens on no port; the only program
# it runs is systemctl, to restart services after an upgrade
CapabilityBoundingSet=CAP_DAC_OVERRIDE
NoNewPrivileges=yes
ReadOnlyDirectories=/
ReadWriteDirectories=/etc/nett /usr/local/lib/nett /usr/local/lib/systemd/system
PrivateTmp=yes
PrivateDevices=yes
# Idle use stays under 5 MB; the limit leaves room for a large desired state or a download
MemoryLimit=64M
Restart=always
RestartSec=5
