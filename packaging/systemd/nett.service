# nett on this machine: the mesh (WireGuard, path selection, the DNS responder for names under
# nett.internal), the TLS transport, and, once the machine has joined a Hub, the connection to its
# Hub, which also installs new releases into /usr/local/lib/nett after verifying their release
# signature. Installed by `sudo nett install`.
# Everything it keeps is in /etc/nett, root only: the keys, the desired state, the Hub settings and
# the trust store. After the desired state changes, `systemctl reload nett` applies it without a
# restart.
[Unit]
Description=nett
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/lib/nett/nett daemon --dir /etc/nett
ExecReload=/bin/kill -HUP $MAINPID
# Local sockets in /run/nett: mesh.sock answers every local user's status queries and takes changes
# only from root; helpers.sock gives the relay its assignment and answers only the relay's unit.
# Others can reach a known name in the directory but not list it
RuntimeDirectory=nett
RuntimeDirectoryMode=0711
# Names under nett.internal go to this machine's DNS responder through systemd-resolved; this step
# runs with full privileges, changes only the settings of nett0, and does nothing without
# systemd-resolved
ExecStartPost=+/usr/local/lib/nett/nett resolver
# Root, with only the capabilities for WireGuard, nftables, path probes and the DNS responder on the
# mesh address (UDP 53). It writes only its own directory, the program it upgrades and nett's units;
# the only program it runs is systemctl, to start or stop the relay and to reload nett's units
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/nett /usr/local/lib/nett /usr/local/lib/systemd/system
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_NETLINK AF_INET AF_INET6 AF_UNIX
# Idle use stays under 8 MB; the limit leaves room for a large desired state or a download. The OOM
# killer picks it late
MemoryMax=64M
OOMScoreAdjust=-500
# It also exits to run a new release once it has installed it
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
