# The nett transport adapter: carries WireGuard packets over TLS to a relay when UDP does not get
# through. It holds no keys and sees only ciphertext.
# nett-node enables it while this machine has a path over TLS. It fetches its configuration from the
# mesh service through /run/nett/helpers.sock.
[Unit]
Description=nett transport adapter
After=network-online.target nett-mesh.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/lib/nett/nett transport
# A dedicated system user without capabilities
User=nett-transport
Group=nett-transport
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Idle use stays under 5 MB
MemoryMax=64M
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
