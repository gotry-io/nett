# The nett mesh service. Installed by `sudo nett install`.
# The desired state is /etc/nett/desired.json (it holds no private keys; readable by the nett group
# only). The mesh private key, /etc/nett/mesh.key (owned by root, mode 0600), reaches the service
# through LoadCredential.
# After the desired state changes, `systemctl reload nett-mesh` applies it without a restart.
[Unit]
Description=nett mesh
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/lib/nett/nett mesh --config /etc/nett/desired.json --key ${CREDENTIALS_DIRECTORY}/mesh.key
ExecReload=/bin/kill -HUP $MAINPID
LoadCredential=mesh.key:/etc/nett/mesh.key
# Local sockets in /run/nett: mesh.sock (0600) for root and nett-node, helpers.sock for the relay
# and the transport adapter, which the service answers only for their own users. Others can reach a
# known name in the directory but not list it
RuntimeDirectory=nett
RuntimeDirectoryMode=0711
# Trust store /var/lib/nett: pinned trust anchors, revocations and applied versions survive restarts
StateDirectory=nett
StateDirectoryMode=0700
# Names under nett.internal go to this machine's DNS responder through systemd-resolved; this step
# runs as root, changes only the settings of nett0, and does nothing without systemd-resolved
ExecStartPost=+/usr/local/lib/nett/nett resolver
# A dedicated system user with only the capabilities for WireGuard, nftables, path probes and the DNS
# responder on the mesh address (UDP 53)
User=nett
Group=nett
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_NETLINK AF_INET AF_INET6 AF_UNIX
# Idle use is about 3 MB; the limit leaves room for peaks. The OOM killer picks the mesh late
MemoryMax=64M
OOMScoreAdjust=-500
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
