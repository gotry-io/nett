# nett-node, the agent that connects this machine to its Hub. Installed by `sudo nett install <token>`.
# It writes the desired state from the Hub to /etc/nett/desired.json, asks the mesh service to reload
# it, and reports status. Hub settings are in /etc/nett/hub.json, the identity key in
# /etc/nett/identity.key. The mesh keeps running without this service; systemd restarts each one.
[Unit]
Description=nett node agent
After=network-online.target nett-mesh.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/nett node --dir /etc/nett
# Runs as root to write the desired state; CAP_DAC_OVERRIDE lets it reach the mesh service's
# socket in /run/nett. It listens on no port and runs no other programs.
CapabilityBoundingSet=CAP_DAC_OVERRIDE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/nett
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Idle use stays under 5 MB; the limit leaves room for a large desired state
MemoryMax=32M
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
