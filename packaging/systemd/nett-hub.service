# nett-hub, run natively under a dedicated system user. It listens on 127.0.0.1:8480; a reverse
# proxy on this host forwards /api/v1/ and /node/v1/connect to it. /var/lib/nett-hub holds the
# database and the Hub's identity key.
# First use:
#   sudo useradd --system --home-dir /var/lib/nett-hub --shell /usr/sbin/nologin nett-hub
#   sudo install -d -o nett-hub -g nett-hub -m 0700 /var/lib/nett-hub
#   sudo -u nett-hub /usr/local/bin/nett-hub init --url https://hub.example.com
#   sudo systemctl enable --now nett-hub
[Unit]
Description=nett Hub
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/nett-hub serve --data /var/lib/nett-hub
User=nett-hub
Group=nett-hub
StateDirectory=nett-hub
StateDirectoryMode=0700
# The Hub needs no capabilities and nothing else on the host
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Steady use is 30–50 MB for tens of machines; the limit leaves headroom
MemoryMax=128M
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
