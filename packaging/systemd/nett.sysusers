# The system user the mesh service runs as. `sudo nett install` writes this file to
# /etc/sysusers.d/nett.conf and runs systemd-sysusers. /etc/nett belongs to the group nett, so the
# mesh service can read the desired state and write the trust store in /etc/nett/state while other
# users cannot. The relay and the transport adapter run as users systemd allocates while they run.
u nett - "nett mesh service" -
