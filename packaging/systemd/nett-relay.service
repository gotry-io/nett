# The nett relay: forwards encrypted WireGuard packets between members that cannot reach each other
# directly, over UDP and TLS. It holds no keys of the mesh and sees only ciphertext.
# nett-node enables it while this machine runs a relay (`nett site relay`). It fetches its assignment
# from the mesh service through /run/nett/helpers.sock. Its TLS certificate, created by nett-node in
# /etc/nett/relay, reaches it through LoadCredential; it saves its bindings in /run/nett-relay, which
# is kept while the service restarts.
[Unit]
Description=nett relay
After=network-online.target nett-mesh.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/lib/nett/nett relay --cert ${CREDENTIALS_DIRECTORY} --state ${RUNTIME_DIRECTORY}/relay-state.json
LoadCredential=tls-cert.der:/etc/nett/relay/tls-cert.der
LoadCredential=tls-key.pk8:/etc/nett/relay/tls-key.pk8
RuntimeDirectory=nett-relay
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
# A user systemd allocates while the service runs, which may bind ports below 1024 (TLS on 443) and
# nothing else
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Idle use stays under 5 MB; the limit leaves room for many links and TLS connections
MemoryMax=64M
# It also exits to bind new ports when its assignment changes them
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
