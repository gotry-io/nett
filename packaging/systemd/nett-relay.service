# The nett relay: forwards encrypted WireGuard packets between members that cannot reach each other
# directly, over UDP and TLS. It holds no keys of the mesh and sees only ciphertext.
# nett-node enables it while this machine runs a relay (`nett site relay`). It fetches its assignment
# from the mesh service through /run/nett/helpers.sock, and keeps its own TLS certificate in
# /var/lib/nett-relay.
[Unit]
Description=nett relay
After=network-online.target nett-mesh.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/lib/nett/nett relay
StateDirectory=nett-relay
StateDirectoryMode=0700
# A dedicated system user that may bind ports below 1024 (TLS on 443) and nothing else
User=nett-relay
Group=nett-relay
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Idle use stays under 5 MB; the limit leaves room for many links and TLS connections
MemoryMax=64M
# It also exits to bind new ports when its assignment changes them
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
