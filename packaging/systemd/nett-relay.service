# The nett relay's TLS entry: accepts the TLS connections of members whose UDP is blocked and hands
# each to the relay in the nett service, which forwards the encrypted WireGuard packets. It holds no
# keys of the mesh and sees only ciphertext.
# The nett service enables it while this machine's relay serves TLS (`nett site relay --tls`). It
# asks the nett service for its ports through /run/nett/helpers.sock. Its TLS certificate, created
# by the nett service in /etc/nett/relay, reaches it through LoadCredential.
[Unit]
Description=nett relay
After=network-online.target nett.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/lib/nett/nett relay --cert ${CREDENTIALS_DIRECTORY}
LoadCredential=tls-cert.der:/etc/nett/relay/tls-cert.der
LoadCredential=tls-key.pk8:/etc/nett/relay/tls-key.pk8
# A user systemd allocates while the service runs, which may bind ports below 1024 (TLS on 443) and
# nothing else
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Idle use stays under 5 MB; the limit leaves room for many TLS connections
MemoryMax=64M
# It also exits to listen on new ports when they change
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
